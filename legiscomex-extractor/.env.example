# Copiar a .env y completar. NO subir .env al repositorio.

# Una sola cuenta de Legiscomex (la de un integrante del equipo).
# Si se dejan vacias, el login se hace a mano en la ventana de Chrome que abre el sistema.
LEGISCOMEX_USER=
LEGISCOMEX_PASSWORD=

# Chrome visible (false) o sin ventana (true). Dejar en false: el WAF del sitio (CloudFront)
# responde 403 a Chrome sin ventana (comprobado el 2026-11-10), y la ventana permite
# completar el login a mano si el automatico falla.
HEADLESS=false

# Segundos que el sistema espera a que una persona complete el login en la ventana.
ESPERA_LOGIN_MANUAL_S=180

# Pausa aleatoria entre cargas de pagina (segundos).
PAUSA_MIN_S=1.5
PAUSA_MAX_S=4

# Segundos durante los que una consulta identica se responde desde la base local.
CACHE_TTL_S=3600

# Agente ADK via OpenRouter (LiteLLM). OPENROUTER_API_KEY se toma del entorno del sistema
# si no se define aqui.
# OPENROUTER_API_KEY=
LLM_MODEL=openrouter/google/gemini-2.5-flash
EXTRACTOR_API=http://127.0.0.1:8000
